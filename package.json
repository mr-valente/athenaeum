{
  "name": "athenaeum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown-first public notes, projects, and classroom resources.",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "verify": "npm test && npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "astro": "7.3.1",
    "katex": "0.16.47",
    "mdast-util-to-string": "4.0.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/hast": "3.0.5",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
