---
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import { parentUrl, sortedPages } from '../lib/content.ts';
import Page from '../layouts/Page.astro';
import mark from '../../design/mark.svg?url';
import GithubIcon from '../components/GithubIcon.astro';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  return entries.map(({ data }) => ({
    params: { page: data.url === '/' ? undefined : data.url.slice(1, -1) },
    props: { page: data, pages: entries.map((entry) => entry.data) },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, pages } = Astro.props;
const children = sortedPages(pages.filter((entry) => parentUrl(entry.url) === page.url));
---

<Page title={page.title} description={page.description} pages={pages}>
  <article>
    {page.url === '/' && <p class="ath-eyebrow"><span aria-hidden="true">~/</span> A place for curious minds</p>}
    <div class="ath-intro">
      {!page.hasHeading && <h1>{page.title}</h1>}
      {page.date && <p class="ath-date"><time datetime={page.date}>{page.date}</time></p>}
      <div class="ath-prose" set:html={page.html} />
      {page.url === '/' && <div class="ath-bookplate" aria-hidden="true"><img src={mark} alt="" width="160" height="160" /></div>}
    </div>
    {page.kind === 'project' && (
      <div class="ath-project-actions">
        <p><a class="ath-project-link" href={page.href}>Open {page.title}<span aria-hidden="true">↗</span></a>{page.status && <span class="ath-project-status"> — {page.status}</span>}</p>
        {page.repository && <p><a class="ath-repository-link" href={page.repository}><GithubIcon />View {page.title} on GitHub</a></p>}
      </div>
    )}
    {page.tags.length > 0 && <p class="ath-tags"><span>Topics:</span>{page.tags.map((tag) => <span class="ath-tag">{tag}</span>)}</p>}
    {children.length > 0 ? (
      <nav aria-label={`In ${page.title}`} class="ath-section-index">
        <div class="ath-index-heading"><h2>{page.url === '/' ? 'Explore the collection' : 'In this collection'}</h2><span>{String(children.length).padStart(2, '0')} {children.length === 1 ? 'entry' : 'entries'}</span></div>
        <ul>
          {children.map((child, index) => <li>
            <a class="ath-entry" href={child.url}>
              <span class="ath-entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span><span class="ath-entry-title">{child.title}</span>
              {child.description && <span class="ath-entry-description">{child.description}</span>}</span>
              <span class="ath-entry-arrow" aria-hidden="true">↗</span>
            </a>
          </li>)}
        </ul>
      </nav>
    ) : page.generated && <p>This collection is just getting started.</p>}
  </article>
</Page>
