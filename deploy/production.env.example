# Copy to /etc/athenaeum/compose.env (mode 0600).
SITE_DOMAIN=valentemath.com
ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL
ACCOUNT_ORIGIN=https://valentemath.com

# Optional: pin a published version or digest for a deliberate rollback.
# ATHENAEUM_IMAGE=valentemath/athenaeum:v0.1.0
# EDGE_IMAGE=valentemath/athenaeum:v0.1.0-edge
# ACCOUNTS_IMAGE=valentemath/athenaeum:v0.1.0-accounts
# QUACKTUARIES_IMAGE=valentemath/quacktuaries:v0.1.0-athenaeum
# BERNOULLI_IMAGE=valentemath/bernoulli:v0.1.0-athenaeum
# SRS_IMAGE=valentemath/srs:v0.1.0-athenaeum
