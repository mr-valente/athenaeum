(app) {
	@root_{args[1]} path {args[0]}
	handle @root_{args[1]} {
		route {
			uri replace {args[0]} {args[0]}/ 1
			redir {uri} 308
		}
	}
	handle {args[0]}/* {
		route {
			respond {args[0]}/_health 404
			@document_{args[1]} {
				method GET
				header Accept *text/html*
			}
			@background_{args[1]} {
				not {
					method GET
					header Accept *text/html*
				}
			}
			sablier @document_{args[1]} http://sablier:10000 {
				group {$SABLIER_GROUP_PREFIX:athenaeum}-{args[1]}
				session_duration {args[3]}
				dynamic {
					display_name {args[2]}
				}
			}
			sablier @background_{args[1]} http://sablier:10000 {
				group {$SABLIER_GROUP_PREFIX:athenaeum}-{args[1]}
				session_duration {args[3]}
				blocking {
					timeout 1m
				}
			}
			uri strip_prefix {args[0]}
			reverse_proxy {args[1]}:8000 {
				header_up -Forwarded
				header_up -X-Forwarded-Prefix
			}
		}
	}
}

# Session tiers: how long an app stays awake after its last request. A route
# names its tier by measured awake memory (skills/athenaeum-app/SKILL.md); the
# environment variables let a test shorten one without editing the routes.
(light) {
	import app {args[0]} {args[1]} {args[2]} {$SABLIER_SESSION_LIGHT:72h}
}

(middle) {
	import app {args[0]} {args[1]} {args[2]} {$SABLIER_SESSION_MIDDLE:12h}
}

(heavy) {
	import app {args[0]} {args[1]} {args[2]} {$SABLIER_SESSION_HEAVY:4h}
}

(superheavy) {
	import app {args[0]} {args[1]} {args[2]} {$SABLIER_SESSION_SUPERHEAVY:1h}
}
