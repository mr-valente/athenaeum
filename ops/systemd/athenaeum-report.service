[Unit]
Description=Athenaeum host report for the homelab monitor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/athenaeumctl report
TimeoutStartSec=90s
Nice=10
# The same sandbox as the backup unit, which runs the same Compose client
# hourly, minus its writable paths: the report reads /proc, statvfs(), the
# private recovery config and backup status, asks Docker for container states
# and makes one outbound HTTPS request, and writes nothing locally. Tighter
# settings (an empty capability set, private devices, address-family limits)
# broke the Compose client under systemd while the shell path kept working.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
