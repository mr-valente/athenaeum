[Unit]
Description=Athenaeum allowlisted image updates
After=network-online.target docker.service athenaeum-metadata-guard.service
Wants=network-online.target
RequiresMountsFor=/srv/athenaeum

[Service]
Type=oneshot
User=root
UMask=0077
Environment=DOCKER_CONFIG=/var/lib/athenaeum/docker
ExecStart=/usr/local/sbin/athenaeumctl deploy
ExecStopPost=/usr/local/sbin/athenaeumctl cleanup-staging
TimeoutStartSec=1h
TimeoutStopSec=60s
KillMode=control-group
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/athenaeum /var/lib/athenaeum
ProtectHome=true
MemoryMax=1G
