#!/bin/sh
# A public PATH entry; private recovery files remain readable only by root.
# Use the operator's existing sudo policy, including its password prompt/cache.
# No new sudoers grant, Docker-group membership, or passwordless access is added.
if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    exec /usr/bin/sudo -- /usr/local/sbin/athenaeumctl "$@"
fi
# Both /usr/local/bin and the systemd /usr/local/sbin entry use this
# launcher. Absolute paths make all commands independent of the shell's cwd.
exec /opt/athenaeum/operations/venv/bin/python /opt/athenaeum/operations/athenaeumctl "$@"
