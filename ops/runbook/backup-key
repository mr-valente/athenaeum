#!/usr/bin/env python3
"""Create or reuse the backup identity on YOUR COMPUTER; print only its public recipient."""
import argparse
import os
from pathlib import Path
import shutil
from _support import finish, say, run, Failure
from athenaeum_ops.common import regular, directory


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, default=Path.home() / '.ssh/athenaeum-backup-identity.txt')
    args = parser.parse_args()
    if os.geteuid() == 0:
        raise Failure('Run locally as your regular user, without sudo.')
    if not shutil.which('age-keygen'):
        raise Failure('Install age first on Arch: sudo pacman -Syu --needed age')
    path = args.output.expanduser().absolute()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory(path.parent)
    if not path.exists() and not path.is_symlink():
        # age-keygen refuses overwrite. Its generated private key goes directly
        # to a private file; only the public recipient is printed below.
        run(['age-keygen', '-o', path])
    regular(path, private=True)
    recipient = run(['age-keygen', '-y', path]).decode().strip()
    say('Identity file: ' + str(path) + '\nPublic recipient: ' + recipient
        + '\nSave the private file in your password manager. Use only the public recipient in VM settings.')


if __name__ == '__main__':
    finish(main)
