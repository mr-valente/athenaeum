#!/usr/bin/env python3
"""Enable only the hourly backup timer after a successful backup and restore drill."""
import argparse
import json
from pathlib import Path
import time
from _support import finish, installed_config, say, visible, Failure


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    cfg = installed_config()
    # Enabling a timer is not proof that recovery works. Require recorded proof
    # first; athenaeumctl status also checks freshness, disk and container health.
    status_file = Path(cfg['state_dir']) / 'status.json'
    if not status_file.is_file():
        raise Failure('Run check-recovery successfully before enabling hourly backups.')
    status = json.loads(status_file.read_text())
    drill = status.get('last_restore_test', {})
    if drill.get('status') != 'ok' or time.time() - drill.get('at', 0) > 30 * 86400:
        raise Failure('Run check-recovery successfully first (restore proof must be less than 30 days old).')
    visible(['athenaeumctl', 'status'])
    visible(['systemctl', 'enable', '--now', 'athenaeum-backup.timer'])
    visible(['systemctl', 'list-timers', 'athenaeum-backup.timer', '--no-pager'])
    say('PASS: hourly backups enabled. Image updates remain manual.')


if __name__ == '__main__':
    finish(main)
